{
  "name": "vena",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive heart made of light. NativeScript-Vue and Jolt RC.11.",
  "main": "src/app.ts",
  "scripts": {
    "ios": "bash scripts/native.sh run ios",
    "pointer": "xcrun swift scripts/preview-pointer.swift",
    "android": "bash scripts/native.sh run android",
    "build:ios": "bash scripts/native.sh build ios --emulator",
    "build:android": "bash scripts/native.sh build android",
    "prepare:ios": "bash scripts/native.sh prepare ios --no-hmr",
    "prepare:android": "bash scripts/native.sh prepare android --no-hmr",
    "bundle:ios": "webpack --env ios",
    "bundle:android": "webpack --env android",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-default-type=module --test tests/*.test.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@nativescript/core": "9.1.3",
    "@rafaelaugusto/jolt": "0.1.0-rc.11",
    "nativescript-vue": "3.1.3",
    "@rafaelaugusto/jolt-native": "0.1.0-rc.11"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/ios": "9.1.0",
    "@nativescript/types": "9.1.1",
    "@nativescript/webpack": "5.0.39",
    "@types/node": "^22.0.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@rafaelaugusto/jolt": "0.1.0-rc.11",
    "@rafaelaugusto/jolt-native": "0.1.0-rc.11",
    "@vue/compiler-core": "3.5.44",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/compiler-ssr": "3.5.44",
    "@vue/reactivity": "3.5.44",
    "@vue/runtime-core": "3.5.44",
    "@vue/shared": "3.5.44"
  },
  "engines": {
    "node": ">=22.16"
  }
}
